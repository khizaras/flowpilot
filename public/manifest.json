{
  "manifest_version": 3,
  "name": "FlowPilot",
  "version": "1.0.0",
  "description": "Chrome Extension for browser workflow recording and automation",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open FlowPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "all_frames": true
    }
  ],
  "permissions": ["storage", "sidePanel", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"]
}
